}

model Workspace {
  id                           String                         @id @default(cuid())
  name                         String
  ownerUserId                  String?                        @map("owner_user_id")
  businessName                 String?                        @map("business_name")
  industry                     String?
  targetAudience               String?                        @map("target_audience")
  status                       WorkspaceStatus                @default(active)
  /// 2026-07-21 (R1) — Emergency kill-switch + per-customer auto-send
  /// toggle + owner WhatsApp number for digest. Per docs/LOGIC.md.
  autonomyKillSwitch           Boolean?                       @default(false) @map("autonomy_kill_switch")
  autoSendToggle               Boolean?                       @default(false) @map("auto_send_toggle")
  ownerWhatsappNumber          String?                        @map("owner_whatsapp_number")
  /// 2026-09-28 — owner's own WhatsApp summary + urgent alerts (all off by
  /// default). Shape: OwnerNotifySettings in src/lib/owner-notify.ts.
  ownerNotifySettings          Json?                          @map("owner_notify_settings")
  /// Stage 5 / WP2 (2026-07-28) — operator kill-switch timestamp. Set when
  /// status → suspended, cleared on resume. See docs/LOGIC.md 2026-07-28.
  suspendedAt                  DateTime?                      @map("suspended_at")
  /// Operator who suspended (audit trail).
  suspendedByAdminId           String?                        @map("suspended_by_admin_id")
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime                       @updatedAt @map("updated_at")
  users                        User[]
  businessProfiles             BusinessProfile[]
  websiteCrawlJobs             WebsiteCrawlJob[]
  websiteCrawlConsents         WebsiteCrawlConsent[]
  websiteCrawlPages            WebsiteCrawlPage[]
  businessExtractions          BusinessExtraction[]
  productKnowledges            ProductKnowledge[]
  productVarieties             ProductVariety[]
  productApplications          ProductApplication[]
  buyerSegments                BuyerSegment[]
  productApplicationMarketMaps ProductApplicationMarketMap[]
  icps                         ICP[]
  campaigns                    Campaign[]
  leads                        Lead[]
  knowledgeEntries             KnowledgeEntry[]
  interactions                 Interaction[]
  humanFallbackTasks           HumanFallbackTask[]
  leadReviewSettings           LeadReviewSettings[]
  leadReviewDecisions          LeadReviewDecision[]
  leadEnrichmentRuns           LeadEnrichmentRun[]
  duplicateCandidates          DuplicateCandidate[]
  messageTemplates             MessageTemplate[]
  outreachActivities           OutreachActivity[]
  replies                      Reply[]
  campaignMetrics              CampaignMetric[]
  campaignLearnings            CampaignLearning[]
  integrations                 Integration[]
  agentRuns                    AgentRun[]
  auditLogs                    AuditLog[]
  webhookEvents                WebhookEvent[]
  processedWebhookMessages     ProcessedWebhookMessage[]
  leadPhoneNumbers             LeadPhoneNumber[]
  providerAccounts             ProviderAccount[]
  whatsAppTemplates            WhatsAppTemplate[]
  eventLogs                    EventLog[]
  jobRuns                      JobRun[]
  agentBehaviorPolicies        AgentBehaviorPolicy[]
  companyCommunicationSettings CompanyCommunicationSettings[]
  conversationPolicies         ConversationPolicy[]
  whatsAppAgentSettings        WhatsAppAgentSettings[]
  escalationRules              EscalationRule[]
  unknownQuestions             UnknownQuestion[]
  autoReplyLogs                AutoReplyLog[]
  mediaCatalogItems            MediaCatalogItem[]
  knowledgeBaseDocuments       KnowledgeBaseDocument[]
  knowledgeBaseChunks          KnowledgeBaseChunk[]
  knowledgeBaseQueryLogs       KnowledgeBaseQueryLog[]
  llmProviderCredentials       LLMProviderCredential[]
  llmModelRoutings             LLMModelRouting[]
  aiUsageLimits                AIUsageLimit[]
  // Phase 4A — back-relations for new models
  userCredentials              UserCredential[]
  doNotContactEntries          DoNotContactEntry[]
  knowledgeQuestionAnswers     KnowledgeQuestionAnswer[]
  knowledgeExtractionRuns      KnowledgeExtractionRun[]
  knowledgeExtractionBatches   KnowledgeExtractionBatch[]
  knowledgeExtractionSourceBundles KnowledgeExtractionSourceBundle[]
  knowledgeExtractionSources   KnowledgeExtractionSource[]
  salesSettings                SalesSettings[]
  policySettings               PolicySettings[]
  communicationSettings        CommunicationSettings[]
  productSettings              ProductSettings[]
  settingsConflicts            SettingsConflict[]
  pendingSettingsDrafts        PendingSettingsDraft[]
  agentAutonomousSettings      AgentAutonomousSettings[]
  /// 2026-07-21 (R1) — Stage 3 Order/Quote back-relations.
  orders                       Order[]
  quotes                       Quote[]
  /// 2026-07-21 (R1) — Stage 2 Ticket back-relation (was missing).
  tickets                      Ticket[]
  /// Stage A (2026-07-26) — WorkspaceMember back-relation. The JSON store
  /// always had this collection; the Prisma schema didn't. Needed for
  /// round-robin ticket assignment (listActiveStaffForWorkspace) and
  /// future team-management features. Pinned by golden:prisma-commercial-parity.
  workspaceMembers             WorkspaceMember[]
  /// Owner Copilot (2026-08-01) — owner-facing assistant chat conversations.
  ownerCopilotConversations    OwnerCopilotConversation[]
  followUps                    FollowUp[]
  outcomeSignals               OutcomeSignal[]
  /// N-DATA-3 (2026-08-18) — back-relations for the ten models that carried a
  /// workspace_id with no foreign key behind it. Without these Postgres did not
  /// know the column pointed anywhere, so deleting a tenant left its rows behind:
  /// 246 orphaned rows were measured in the ship database before this was added.
  ticketEvents                 TicketEvent[]
  ticketSlaSettingsRows        TicketSlaSettings[]
  platformTickets              PlatformTicket[]
  platformTicketEvents         PlatformTicketEvent[]
  platformUserBlocks           PlatformUserBlock[]
  featureFlags                 FeatureFlag[]
  passwordResetTokens          PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  invites                      Invite[]
  ownerCopilotMessages         OwnerCopilotMessage[]

  @@map("workspaces")
}

model User {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  email       String
  role        UserRole  @default(owner)
  /// Stage 5 / WP1 (2026-07-28) — When the user verified their email. Per
  /// docs/LOGIC.md: signup is SOFT-verified (login allowed before verifying);
  /// this field drives the in-app banner + future "required" tightening.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Stage A (2026-07-26) — back-relation for WorkspaceMember.
  workspaceMembers WorkspaceMember[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("users")
}

/// Stage A (2026-07-26) — Workspace membership. Mirrors the JSON
/// `WorkspaceMember` type (src/lib/types.ts:79). Required for:
///   1. Round-robin ticket assignment (WorkspacePrismaRepository
///      .listActiveStaffForWorkspace, was returning [] because there was
///      no table to query).
///   2. Future team-management UI (invite, role-change, deactivate).
///   3. Auth: bootstrapOwner writes a row here so the owner is a real
///      member of the workspace.
/// One row per (workspace, user). Status tracks invite lifecycle.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  // N-DATA-18 (2026-08-25, audit A-7): NULLABLE, and it has to be. An invited
  // member has no User row yet - the User is created when they accept. The
  // invite flow used to write the empty string here, which JSON accepted (a
  // file does not check) and Postgres refused with
  // workspace_members_user_id_fkey, so inviting a teammate was 100% broken on
  // the substrate we ship on. Nullable also FIXES @@unique([workspaceId,
  // userId]): Postgres treats NULLs as distinct, so two pending invites can
  // coexist, where two empty strings could not. Duplicate invites are still
  // blocked by @@unique([workspaceId, email]).
  userId      String?   @map("user_id")
  email       String
  name        String?
  role        UserRole
  status      String    @default("active") // "active" | "invited" | "disabled"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model BusinessProfile {
  id                       String                @id @default(cuid())
  workspaceId              String                @map("workspace_id")
  companyName              String?               @map("company_name")
  websiteUrl               String?               @map("website_url")
  industry                 String?
  businessType             String?               @map("business_type")
  description              String?
  productsJson             Json?                 @map("products_json")
  servicesJson             Json?                 @map("services_json")
  productCategoriesJson    Json?                 @map("product_categories_json")
  contactEmail             String?               @map("contact_email")
  contactPhone             String?               @map("contact_phone")
  whatsappNumber           String?               @map("whatsapp_number")
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  targetGeographiesJson    Json?                 @map("target_geographies_json")
  currentCustomerTypesJson Json?                 @map("current_customer_types_json")
  desiredCustomerTypesJson Json?                 @map("desired_customer_types_json")
  strengthsJson            Json?                 @map("strengths_json")
  limitationsJson          Json?                 @map("limitations_json")
  certificationsJson       Json?                 @map("certifications_json")
  socialLinksJson          Json?                 @map("social_links_json")
  catalogueLinksJson       Json?                 @map("catalogue_links_json")
  proofAssetsJson          Json?                 @map("proof_assets_json")
  languagePreference       String?               @map("language_preference")
  tonePreference           String?               @map("tone_preference")
  status                   BusinessProfileStatus @default(draft)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  workspace                Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icps                     ICP[]
  campaigns                Campaign[]
  fieldsJson               Json?            @map("fields_json")
  /// N13 (2026-09-25): which checklist the business is asked. Kinds are
  /// manufacturer / trader / retailer / service; exports is an add-on.
  /// Unset confirmed_at = not confirmed, a proposal is shown instead.
  checklistKinds           String[]         @default([]) @map("checklist_kinds")
  checklistExports         Boolean          @default(false) @map("checklist_exports")
  checklistConfirmedAt     DateTime?        @map("checklist_confirmed_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("business_profiles")
}

model WebsiteCrawlJob {
  id                  String               @id @default(cuid())
  workspaceId         String               @map("workspace_id")
  websiteUrl          String               @map("website_url")
  status              CrawlStatus          @default(pending)
  pagesFound          Int                  @default(0) @map("pages_found")
  pagesCrawled        Int                  @default(0) @map("pages_crawled")
  errorMessage        String?              @map("error_message")
  startedAt           DateTime?            @map("started_at")
  completedAt         DateTime?            @map("completed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages               WebsiteCrawlPage[]
  businessExtractions BusinessExtraction[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("website_crawl_jobs")
}

model WebsiteCrawlPage {
  id           String          @id @default(cuid())
  crawlJobId   String          @map("crawl_job_id")
  workspaceId  String          @map("workspace_id")
  url          String
  title        String?
  rawHtml      String?         @map("raw_html")
  cleanedText  String?         @map("cleaned_text")
  metadataJson Json?           @map("metadata_json")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  job          WebsiteCrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([crawlJobId])
  @@map("website_crawl_pages")
}

model BusinessExtraction {
  id                           String           @id @default(cuid())
  workspaceId                  String           @map("workspace_id")
  crawlJobId                   String?          @map("crawl_job_id")
  extractedCompanyName         String?          @map("extracted_company_name")
  extractedIndustry            String?          @map("extracted_industry")
  extractedProductsJson        Json?            @map("extracted_products_json")
  extractedServicesJson        Json?            @map("extracted_services_json")
  extractedContactsJson        Json?            @map("extracted_contacts_json")
  extractedLocationsJson       Json?            @map("extracted_locations_json")
  extractedSocialsJson         Json?            @map("extracted_socials_json")
  extractedStrengthsJson       Json?            @map("extracted_strengths_json")
  extractedTargetCustomersJson Json?            @map("extracted_target_customers_json")
  extractedCertificationsJson  Json?            @map("extracted_certifications_json")
  extractedCatalogueLinksJson  Json?            @map("extracted_catalogue_links_json")
  confidenceJson               Json?            @map("confidence_json")
  missingFieldsJson            Json?            @map("missing_fields_json")
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @updatedAt @map("updated_at")
  workspace                    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  crawlJob                     WebsiteCrawlJob? @relation(fields: [crawlJobId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([crawlJobId])
  @@map("business_extractions")
}

model ICP {
  id                     String            @id @default(cuid())
  workspaceId            String            @map("workspace_id")
  businessProfileId      String            @map("business_profile_id")
  name                   String
  description            String?
  buyerType              String?           @map("buyer_type")
  industriesJson         Json?             @map("industries_json")
  geographyJson          Json?             @map("geography_json")
  companySizeBucket      CompanySizeBucket @default(unknown) @map("company_size_bucket")
  likelyNeedsJson        Json?             @map("likely_needs_json")
  buyingTriggersJson     Json?             @map("buying_triggers_json")
  painPointsJson         Json?             @map("pain_points_json")
  preferredChannelsJson  Json?             @map("preferred_channels_json")
  messagingAnglesJson    Json?             @map("messaging_angles_json")
  qualificationRulesJson Json?             @map("qualification_rules_json")
  // Session 55 (2026-09-09): who the workspace does NOT sell to. Added to the
  // domain type and the screen first; without a column the screen saved, the
  // API answered 200, and the value evaporated on the substrate we ship on.
  exclusionsJson         Json?             @map("exclusions_json")
  confidenceScore        Float             @default(0) @map("confidence_score")
  status                 ICPStatus         @default(suggested)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  workspace              Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile        BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  campaigns              Campaign[]
  leads                  Lead[]

  @@index([workspaceId])
  @@index([businessProfileId])
  @@index([workspaceId, status])
  @@map("icps")
}

model Campaign {
  id                   String              @id @default(cuid())
  workspaceId          String              @map("workspace_id")
  businessProfileId    String              @map("business_profile_id")
  icpId                String              @map("icp_id")
  name                 String
  goal                 String?
  targetRegionJson     Json?               @map("target_region_json")
  productFocusJson     Json?               @map("product_focus_json")
  offer                String?
  selectedChannelsJson Json?               @map("selected_channels_json")
  dailyOutreachLimit   Int                 @default(20) @map("daily_outreach_limit")
  leadGoal             Int                 @default(50) @map("lead_goal")
  planJson             Json?               @map("plan_json")
  status               CampaignStatus      @default(draft)
  approvalStatus       ApprovalStatus      @default(needs_review) @map("approval_status")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile      BusinessProfile     @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  icp                  ICP                 @relation(fields: [icpId], references: [id], onDelete: Cascade)
  leads                Lead[]
  leadEnrichmentRuns   LeadEnrichmentRun[]
  messageTemplates     MessageTemplate[]
  outreachActivities   OutreachActivity[]
  replies              Reply[]
  campaignMetrics      CampaignMetric[]
  campaignLearnings    CampaignLearning[]

  @@index([workspaceId])
  @@index([businessProfileId])
  @@index([icpId])
  @@index([workspaceId, status])
  @@index([workspaceId, approvalStatus])
  @@map("campaigns")
}

model Lead {
  id                  String               @id @default(cuid())
  workspaceId         String               @map("workspace_id")
  campaignId          String?              @map("campaign_id")
  icpId               String?              @map("icp_id")
  companyName         String?              @map("company_name")
  contactName         String?              @map("contact_name")
  contactRole         String?              @map("contact_role")
  websiteUrl          String?              @map("website_url")
  source              String?
  sourceUrl           String?              @map("source_url")
  sourceType          String?              @map("source_type")
  linkedinUrl         String?              @map("linkedin_url")
  instagramUrl        String?              @map("instagram_url")
  facebookUrl         String?              @map("facebook_url")
  email               String?
  phone               String?
  whatsappNumber      String?              @map("whatsapp_number")
  country             String?
  state               String?
  city                String?
  address             String?
  buyerType           String?              @map("buyer_type")
  industry            String?
  companySizeBucket   CompanySizeBucket    @default(unknown) @map("company_size_bucket")
  fitReason           String?              @map("fit_reason")
  discoveredInfo      String?              @map("discovered_info")
  personalizationNote String?              @map("personalization_note")
  /// N4 (2026-09-18) — what this buyer has told us, in plain sentences.
  /// Written after a conversation and read before the next one. Kept ON the
  /// lead, where the owner can see and correct it, rather than in a private
  /// store the AI alone can read.
  conversationMemory  String?              @map("conversation_memory")
  /// "ai" or "owner". An owner's correction is never overwritten by the AI.
  conversationMemorySource String?         @map("conversation_memory_source")
  conversationMemoryAt DateTime?           @map("conversation_memory_at")
  /// N11 (2026-09-18) — which facts from the discovery checklist this buyer has
  /// told us, and which have already been asked. Shaped
  /// { "<factKey>": { value, answeredAt?, askedAt? } }.
  /// Kept as JSON rather than its own table because it is read and written as a
  /// whole, once per conversation, and never queried across leads.
  discoveryStateJson   Json?               @map("discovery_state_json")
  /// N12 — lines the owner added to this one lead's checklist.
  discoveryExtrasJson  Json?               @map("discovery_extras_json")
  leadScore           Int                  @default(0) @map("lead_score")
  fitScore            Int                  @default(0) @map("fit_score")
  needScore           Int                  @default(0) @map("need_score")
  reachabilityScore   Int                  @default(0) @map("reachability_score")
  timingScore         Int                  @default(0) @map("timing_score")
  confidenceScore     Float                @default(0) @map("confidence_score")
  qualificationStatus QualificationStatus  @default(unqualified) @map("qualification_status")
  scoreReasonJson     Json?                @map("score_reason_json")
  enrichmentResultJson Json?               @map("enrichment_result_json")
  relevancyReason     String?              @map("relevancy_reason")
  status              LeadStatus           @default(needs_review)
  enrichmentStatus    EnrichmentStatus     @default(not_started) @map("enrichment_status")
  reviewStatus        ReviewStatus         @default(pending) @map("review_status")
  doNotContact        Boolean              @default(false) @map("do_not_contact")
  consentStatus       String?              @map("consent_status")
  assignedTo          String?              @map("assigned_to")
  lastContactedAt     DateTime?            @map("last_contacted_at")
  // CP-24 (2026-08-02): timestamp of the customer's LAST INBOUND message.
  // Distinct from lastContactedAt (which = WE contacted THEM, outbound only).
  // Drives the WhatsApp 24-hour customer-service window gate.
  lastInboundAt       DateTime?            @map("last_inbound_at")
  nextFollowUpAt      DateTime?            @map("next_follow_up_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign            Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  icp                 ICP?                 @relation(fields: [icpId], references: [id], onDelete: SetNull)
  enrichmentRuns      LeadEnrichmentRun[]
  duplicateAsFirst    DuplicateCandidate[] @relation("DuplicateLeadOne")
  duplicateAsSecond   DuplicateCandidate[] @relation("DuplicateLeadTwo")
  interactions        Interaction[]
  messageTemplates    MessageTemplate[]
  outreachActivities  OutreachActivity[]
  replies             Reply[]
  /// 2026-07-21 (R1) — Stage 3 commercial relations.
  orders              Order[]
  quotes              Quote[]
  /// Stage 6 / WP6-C (2026-07-30) — all phone/WhatsApp numbers for this lead.
  phoneNumbers        LeadPhoneNumber[]
  followUps           FollowUp[]
  outcomeSignals      OutcomeSignal[]

  @@index([workspaceId])
  @@index([campaignId])
  @@index([icpId])
  @@index([workspaceId, status])
  @@index([workspaceId, reviewStatus])
  @@index([workspaceId, enrichmentStatus])
  @@index([workspaceId, qualificationStatus])
  @@index([email])
  @@index([phone])
  @@index([whatsappNumber])
  @@index([websiteUrl])
  @@map("leads")
}

/// Stage 6 / WP6-C (2026-07-30) — all phone/WhatsApp numbers per lead. The
/// Lead's flat phone/whatsappNumber fields stay as the PRIMARY; this table
/// holds the full list so inbound lookup (findLeadByPhone) matches ANY number
/// (6C-2 dedup-across-numbers), not just the primary.
model LeadPhoneNumber {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  leadId           String   @map("lead_id")
  number           String
  /// Digit-only normalized form — the match key for findLeadByPhone.
  normalizedDigits String   @map("normalized_digits")
  /// "whatsapp" | "phone" | "mobile" | "landline" | "other"
  type             String
