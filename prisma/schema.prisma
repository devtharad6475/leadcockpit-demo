/// Inbound message-id dedup log. Stops Meta's duplicate webhook deliveries
/// from creating duplicate leads / replies / tickets / DNC registrations.
/// Stage 6 / 2026-07-30 (audit I-6): persisted in BOTH JSON and Prisma modes.
/// Previously Prisma's readAll/mutateAll silently dropped this collection,
/// so production dedup was inactive (the service logged a WARNING).
model ProcessedWebhookMessage {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  /// Meta's message.id — the dedup key (globally unique per Meta).
  providerMessageId String  @map("provider_message_id")
  fromPhone        String?  @map("from_phone")
  processedAt      DateTime @map("processed_at")
  /// "processed" | "ignored" | "blocked" | "duplicate_skipped"
  outcome          String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The dedup key — one row per (workspace, message). Enforced at the DB
  /// level so even a concurrent double-insert cannot create a duplicate.
  @@unique([workspaceId, providerMessageId])
  @@index([workspaceId])
  @@map("processed_webhook_messages")
}

