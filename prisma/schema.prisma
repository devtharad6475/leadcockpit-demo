  category    String    @default("other")
  fileName    String    @map("file_name")
  fileType    String    @map("file_type")
  fileSize    Int       @default(0) @map("file_size")
  url         String
  storagePath String    @map("storage_path")
  // 2026-09-10 (session 55): the bytes live HERE, not on the container's disk.
  // The old code wrote uploads to public/uploads inside the running container.
  // That directory is not a disk: every deploy and every free-tier spin-down
  // replaced the container, so the file vanished while this row survived,
  // pointing `url` at a 404 -- and WhatsApp sends hand Meta a LINK it has to
  // fetch, so the photo silently failed to send too. Base64 in a TEXT column
  // keeps the file wherever the database is, which is the only durable store
  // this deployment actually has. Never selected by the list/export queries.
  contentBase64 String? @map("content_base64")
  caption     String?
  leadId      String?   @map("lead_id")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@index([leadId])
  @@map("media_catalog_items")
}

