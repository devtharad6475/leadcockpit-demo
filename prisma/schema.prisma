generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  active
  paused
  archived
  /// Stage 5 / WP2 (2026-07-28) — operator kill-switch. Blocks logins for
  /// the workspace's users; preserves all data; reversible. See LOGIC.md.
  suspended
}

enum UserRole {
  owner
  admin
  sales_member
  viewer
}

enum BusinessProfileStatus {
  draft
  reviewed
  approved
}

enum CrawlStatus {
  pending
  running
  completed
  failed
}

enum ICPStatus {
  suggested
  selected
  rejected
  archived
}

enum CompanySizeBucket {
  solo_small_business
  small_company
  medium_company
  large_company
  unknown
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum ApprovalStatus {
  needs_review
  approved
  rejected
}

enum LeadStatus {
  prospected
  contacted_cold
  talking
  sample_phase
  discovered
  needs_review
  approved
  rejected
  enriching
