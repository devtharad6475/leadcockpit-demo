// ===========================================================================
// 2026-07-21 (R1) — Stage 3 Order + Quote models.
// Per docs/LOGIC.md 2026-07-21:
//   - Quote is optional; orders can be direct OR from_quote.
//   - Conversion snapshots prices; new quotes supersede old.
//   - Reorder pre-fills from a past order.
//   - NO Invoice, NO tax computation — Tally/ERP's job.
// ===========================================================================

model Order {
  id                     String   @id @default(cuid())
  workspaceId            String   @map("workspace_id")
  orderNumber            Int      @default(0) @map("order_number")
  leadId                 String?  @map("lead_id")
  quoteId                String?  @map("quote_id")
  status                 String   @default("draft")
  lineItemsJson          Json     @map("line_items_json")
  grandTotal             Decimal  @db.Decimal(12, 2) @map("grand_total")
  currencyCode           String   @default("INR") @map("currency_code")
  origin                 String   @default("direct")
  reorderedFromOrderId   String?  @map("reordered_from_order_id")
  /// 2026-07-21 — conversation link (disputes).
  sourceReplyId          String?  @map("source_reply_id")
  sourceInteractionId    String?  @map("source_interaction_id")
  /// 2026-07-21 — discount flag (informational).
  discountGiven          Boolean? @default(false) @map("discount_given")
  totalDiscountAmount    Decimal? @db.Decimal(12, 2) @map("total_discount_amount")
  shippedQuantityByLine  Json?    @map("shipped_quantity_by_line")
  /// Stage A (2026-07-26) — Per-line cancelled quantity when the order is
  /// partially or fully cancelled. Keyed by OrderLineItem.id. Was missing
  /// from the Prisma schema (Cluster C fix added it to the JSON runtime +
  /// the Order type, but the schema column was never added). Pinned by
  /// golden:prisma-commercial-parity.
  cancelledQuantityByLineJson Json? @map("cancelled_quantity_by_line_json")
  confirmedAt            DateTime? @map("confirmed_at")
  shippedAt              DateTime? @map("shipped_at")
  deliveredAt            DateTime? @map("delivered_at")
  cancelledAt            DateTime? @map("cancelled_at")
  cancelledBy            String?  @map("cancelled_by")
  cancelReason           String?  @map("cancel_reason")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead                   Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, orderNumber])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([leadId])
  @@index([quoteId])
  @@map("orders")
}

model Quote {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  quoteNumber       Int      @default(0) @map("quote_number")
  leadId            String?  @map("lead_id")
  orderId           String?  @map("order_id")
  supersedesQuoteId String?  @map("supersedes_quote_id")
  status            String   @default("draft")
  lineItemsJson     Json     @map("line_items_json")
  grandTotal        Decimal  @db.Decimal(12, 2) @map("grand_total")
  currencyCode      String   @default("INR") @map("currency_code")
  validityNote      String?  @map("validity_note")
  sentAt            DateTime? @map("sent_at")
  acceptedAt        DateTime? @map("accepted_at")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, quoteNumber])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([leadId])
  @@map("quotes")
}

// ───────────────────────────────────────────────────────────────────────────
// Stage 5 / WP3 (2026-07-28) — Platform tickets (user → operator) + PlatformAdmin.
// Deliberately NOT relation-coupled to Workspace/User: these are the operator's
// records, shared across all workspaces. A Workspace.onDelete cascade must NOT
// delete platform tickets (they're the operator's audit/support trail). So
// workspaceId / raisedByUserId are plain strings, no FK. See docs/LOGIC.md.
// ───────────────────────────────────────────────────────────────────────────

enum PlatformTicketCategory {
  bug
  account
  billing
  how_to
  data_request
  other
}

enum PlatformTicketStatus {
  open
  in_progress
  waiting_on_user
  resolved
  closed
  reopened
}

enum PlatformTicketEventType {
  created
  status_changed
  priority_changed
  assigned
  commented
  sla_breached
  reopened
  resolved
  closed
}

enum PlatformTicketActorType {
  user
  operator
  system
}

enum PlatformAdminRole {
  operator
  support_agent
}

enum PlatformAdminStatus {
  active
  suspended
}

enum PlatformAuditEvent {
  admin_login
  /// 2026-09-28 (S4) — operator signed out (all earlier admin cookies ended).
  admin_logout
  admin_login_failed
  admin_created
  admin_suspended
  ticket_flagged_spam
  ticket_assigned
  ticket_status_changed
  user_blocked
  user_unblocked
  workspace_suspended
  workspace_resumed
  impersonation_started
  impersonation_ended
  config_changed
  /// Stage 5 / WP2 (2026-07-28) — operator issued a password reset.
  password_reset_issued
}

model PlatformTicket {
  id               String                 @id @default(cuid())
  workspaceId      String                 @map("workspace_id")
  raisedByUserId   String                 @map("raised_by_user_id")
  /// Sequential GLOBALLY (operator inbox numbering), not per-workspace.
  ticketNumber     Int                    @default(0) @map("ticket_number")
  subject          String
  description      String
  category         PlatformTicketCategory
  status           PlatformTicketStatus   @default(open)
  priority         String
  assignedAdminId  String?                @map("assigned_admin_id")
  isSpamFlagged    Boolean                @default(false) @map("is_spam_flagged")
  spamReason       String?                @map("spam_reason")
  flaggedByAdminId String?                @map("flagged_by_admin_id")
  slaStartedAt     DateTime               @map("sla_started_at")
  slaDueAt         DateTime               @map("sla_due_at")
  firstResponseAt  DateTime?              @map("first_response_at")
  resolvedAt       DateTime?              @map("resolved_at")
  closedAt         DateTime?              @map("closed_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt        @map("updated_at")
  events           PlatformTicketEvent[]
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([workspaceId])
  @@index([raisedByUserId])
  @@index([isSpamFlagged])
  @@index([assignedAdminId])
  @@unique([ticketNumber])
  @@map("platform_tickets")
}

model PlatformTicketEvent {
  id           String                  @id @default(cuid())
  ticketId     String                  @map("ticket_id")
  workspaceId  String                  @map("workspace_id")
  eventType    PlatformTicketEventType @map("event_type")
  actorType    PlatformTicketActorType @map("actor_type")
  actorUserId  String?                 @map("actor_user_id")
  actorAdminId String?                 @map("actor_admin_id")
  fromStatus   PlatformTicketStatus?   @map("from_status")
  toStatus     PlatformTicketStatus?   @map("to_status")
  note         String?
  createdAt    DateTime                @default(now()) @map("created_at")
  ticket       PlatformTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([workspaceId])
  @@map("platform_ticket_events")
}

/// 2026-07-28 — Singleton row (id = "default"). The operator's support-hours
/// window for the platform-ticket SLA clock. Tunable in the admin panel.
model PlatformSupportHours {
  id           String   @id @default("default")
  hoursStart   String   @map("hours_start") // "HH:MM" 24h
  hoursEnd     String   @map("hours_end")
  businessDays Int[]    @map("business_days") // ISO weekday [1..7]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt        @map("updated_at")

  @@map("platform_support_hours")
}

/// 2026-07-28 — Singleton row (id = "default"). The operator's INTERNAL SLA
/// targets per priority. User never sees these.
model PlatformTicketSlaSettings {
  id                String   @id @default("default")
  urgentSlaMinutes  Int      @map("urgent_sla_minutes")
  highSlaMinutes    Int      @map("high_sla_minutes")
  mediumSlaMinutes  Int      @map("medium_sla_minutes")
  lowSlaMinutes     Int      @map("low_sla_minutes")
  clockMode         String   @default("business_hours") @map("clock_mode")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt        @map("updated_at")

  @@map("platform_ticket_sla_settings")
}

model PlatformUserBlock {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  workspaceId           String   @map("workspace_id")
  isBlockedFromSupport  Boolean  @default(false) @map("is_blocked_from_support")
  reason                String?
  blockedByAdminId      String   @map("blocked_by_admin_id")
  blockedAt             DateTime @default(now()) @map("blocked_at")
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([workspaceId])
  @@map("platform_user_blocks")
}

model PlatformAdmin {
  id          String             @id @default(cuid())
  email       String             @unique
  name        String
  role        PlatformAdminRole  @default(operator)
  status      PlatformAdminStatus @default(active)
  lastLoginAt DateTime?          @map("last_login_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt        @map("updated_at")
  credential  PlatformAdminCredential?
  auditLogs   PlatformAuditLog[]

  @@map("platform_admins")
}

model PlatformAdminCredential {
  id           String   @id @default(cuid())
  adminId      String   @unique @map("admin_id")
  email        String
  passwordHash String   @map("password_hash")
  /// 2026-09-28 (S4): bumped on sign-out so a copied admin cookie stops working.
  sessionVersion Int    @default(1) @map("session_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt        @map("updated_at")
  admin        PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("platform_admin_credentials")
}

model PlatformAuditLog {
  id        String             @id @default(cuid())
  adminId   String             @map("admin_id")
  action    PlatformAuditEvent
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")
  admin     PlatformAdmin      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ============================================================================
// Stage 5 / WP2 (2026-07-28) — operator admin panel models.
// See docs/LOGIC.md 2026-07-28 for the exact rules these enforce.
// ============================================================================

/// Global feature-flag kill-switch. Per LOGIC.md: a FIXED set of keys, all
/// global (workspaceId = null — no per-workspace overrides in WP2). Default
/// value for an unset flag is TRUE (system "on"; operator flips to false).
model FeatureFlag {
  id                   String   @id @default(cuid())
  key                  String
  /// Always null in WP2 (global flags only). Kept as nullable for a future
  /// per-workspace-override stage without a schema change.
  workspaceId          String?  @map("workspace_id")
  enabled              Boolean  @default(true)
  lastToggledByAdminId String   @map("last_toggled_by_admin_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([key, workspaceId])
  @@index([key])
  @@map("feature_flags")
}

/// One-time password-reset token issued by an operator. The token is stored
/// HASHED (never plaintext), has a 24-hour expiry, and is delivered to the
/// user via email. Issuing bumps the user's UserCredential.sessionVersion
/// (existing sessions killed).
model PasswordResetToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  workspaceId     String    @map("workspace_id")
  /// SHA-256 hash of the raw token. The raw token is NEVER stored.
  tokenHash       String    @map("token_hash")
  issuedAt        DateTime  @map("issued_at")
  /// issuedAt + 24h. After this the token is rejected.
  expiresAt       DateTime  @map("expires_at")
  /// Stamped when the user sets a new password with this token.
  consumedAt      DateTime? @map("consumed_at")
  issuedByAdminId String    @map("issued_by_admin_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// An active operator→workspace-user impersonation session. Per LOGIC.md:
/// operator-only, 15-minute TTL, one at a time, owner blocked, fully audited.
model ImpersonationSession {
  id                String    @id @default(cuid())
  adminId           String    @map("admin_id")
  targetUserId      String    @map("target_user_id")
  targetWorkspaceId String    @map("target_workspace_id")
  /// SHA-256 hash of the token presented to the workspace-session layer.
  tokenHash         String    @map("token_hash")
  startedAt         DateTime  @map("started_at")
  /// startedAt + 15min. After this the session is rejected.
  expiresAt         DateTime  @map("expires_at")
  /// Stamped on exitImpersonation; a session with endedAt is invalid.
  endedAt           DateTime? @map("ended_at")
  reason            String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([adminId])
  @@index([tokenHash])
  @@map("impersonation_sessions")
}

/// Stage 5 / WP1 (2026-07-28) — Email verification token. One-time, hashed,
/// 24h expiry, idempotent verify. Same security shape as PasswordResetToken.
/// See docs/LOGIC.md 2026-07-28 (WP1 entries).
model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  /// SHA-256 hash of the raw token. The raw token is NEVER stored.
  tokenHash   String   @map("token_hash")
  issuedAt    DateTime @map("issued_at")
  /// issuedAt + 24h. After this the token is rejected.
  expiresAt   DateTime @map("expires_at")
  /// Stamped when the user clicks the verify link.
  consumedAt  DateTime? @map("consumed_at")
  /// "signup" | "reissue"
  source      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

/// Stage 5 / WP1 (2026-07-28) — Member invite. Pending → (accepted | revoked |
/// expired). 7-day expiry, token hashed, owner/admin issues by email with a
/// role from {admin, sales_member, viewer} (NEVER owner). See docs/LOGIC.md.
model Invite {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  email           String
  role            String
  /// SHA-256 hash of the raw token. The raw token is NEVER stored.
  tokenHash       String   @map("token_hash")
  status          String   @default("pending") // pending | accepted | revoked | expired
  invitedByUserId String   @map("invited_by_user_id")
  acceptedByUserId String? @map("accepted_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  /// createdAt + 7d. After this, accept is refused.
  expiresAt       DateTime @map("expires_at")
  resolvedAt      DateTime? @map("resolved_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email, status])
  @@index([workspaceId])
  @@index([tokenHash])
  @@index([workspaceId, email])
  @@map("invites")
}

/// Owner Copilot (2026-08-01) — owner-facing assistant chat.
/// Design: docs/planning/OWNER_COPILOT_DESIGN.md. Persists the conversation so
/// the chat survives refresh + is auditable. The 5-tier router + Quote handler
/// live in OwnerCopilotService; these tables only store chat state.
/// 2026-09-27 — a reminder to do something later about one customer. Only an
/// "open" (owner-confirmed) reminder counts. Deleted with its customer.
model FollowUp {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  leadId      String    @map("lead_id")
  /// IST calendar date YYYY-MM-DD; null on a proposal not dated yet.
  dueOn       String?   @map("due_on")
  note        String
  source      String    @default("owner")
  evidence    String?
  status      String    @default("open")
  /// 2026-09-28 — "reorder" | "dormant" on proposals from order history.
  kind        String?
  /// 2026-09-28 — the order cycle (last order id) a reorder proposal belongs to.
  cycleKey    String?   @map("cycle_key")
  createdBy   String?   @map("created_by")
  doneAt      DateTime? @map("done_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, dueOn])
  @@index([workspaceId, leadId])
  @@map("follow_ups")
}

/// 2026-09-28 — a real result for one customer (order placed, opted out,
/// complaint, no reply in 14 days…). The weekly learning step proposes
/// patterns from these; nothing changes by itself. Deleted with its customer.
model OutcomeSignal {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  leadId          String    @map("lead_id")
  kind            String
  at              DateTime
  value           Float?
  relatedReplyIds String[]  @default([]) @map("related_reply_ids")
  sourceId        String?   @map("source_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, sourceId])
  @@index([workspaceId, at])
  @@index([workspaceId, leadId])
  @@map("outcome_signals")
}

model OwnerCopilotConversation {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  ownerUserId       String   @map("owner_user_id")
  /// The lead the owner is currently talking about (global panel; actions
  /// stay per-lead-isolated). Nullable — T1 read-only Q&A can have none.
  activeLeadId      String?  @map("active_lead_id")
  clarifyBatchCount Int      @default(0) @map("clarify_batch_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages          OwnerCopilotMessage[]

  @@index([workspaceId])
  @@index([workspaceId, ownerUserId])
  @@map("owner_copilot_conversations")
}

model OwnerCopilotMessage {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  conversationId   String   @map("conversation_id")
  role             String // "owner" | "copilot"
  kind             String // owner_input | copilot_question | copilot_draft | ...
  text             String
  language         String   @default("unknown") // "en" | "hi" | "unknown"
  tier             String? // T1..T5
  pendingActionJson Json?   @map("pending_action_json")
  createdAt        DateTime @default(now()) @map("created_at")
  conversation     OwnerCopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conversationId])
  @@map("owner_copilot_messages")
}
