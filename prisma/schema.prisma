model Reply {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  campaignId          String?   @map("campaign_id")
  // N-DATA-19 (2026-08-25, audit A-7): NULLABLE, and it has to be. An inbound
  // WhatsApp message from a number we have never seen has no lead to attach
  // to - that is the ordinary case, not an edge case - and the product
  // deliberately writes no lead id rather than the fake
  // "unmatched_whatsapp_lead" it used to write, because those rows survived
  // erasure. JSON accepted the absence (a file does not check); Postgres
  // refused the whole create, so EVERY inbound from an unknown number was a
  // 500 on the substrate we ship on, and the reply that is supposed to be
  // recorded "always, no silent drops" was silently dropped.
  leadId              String?   @map("lead_id")
  channel             String
  rawText             String    @map("raw_text")
  classification      String?
  confidenceScore     Float?    @map("confidence_score")
  summary             String?
  suggestedNextAction String?   @map("suggested_next_action")
  suggestedResponse   String?   @map("suggested_response")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead                Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@index([leadId])
  @@index([classification])
  @@map("replies")
}

