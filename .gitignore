# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ruflo / claude-flow runtime (legacy; not used by current ZCode workflow)
.claude-flow/
.swarm/
.claude/

# leadgen runtime data (JSON demo store, locks, backups, dev logs)
# Keep app-data.json (the seed/demo store) but ignore everything else under .leadgen-data
.leadgen-data/app-data.lock/
.leadgen-data/*.log
.leadgen-data/*.backup-*.json
.leadgen-data/backups/
.leadgen-data/app-data.snapshot.spec.json
# Ad-hoc rescue copies written by scripts before a risky migration/fixture load.
# Genuinely useful on disk, pure noise in history — they are point-in-time copies
# of a file git already versions.
.leadgen-data/*.bak-*
.leadgen-data/neon-pre-audit-export.json
# Per-run output of scripts/walk-the-sale-path.ts. One timestamped file per run,
# so these accumulate and dirty the tree; the run prints its own summary.
.leadgen-data/walk-*.json

# scratch / logs / screenshots — never commit
*.log
*.err.log
*.out.log
*.png
*.db
q.channel

# graphify analysis artifacts
.graphify_*.json
graphify-out/
graphify_*.py

# misc ad-hoc test/json scratch
ds_chat.json
ds_models.json
test-slots.mjs

# UI debug dumps
ui-debug-*.txt
ui-dom-*.html
ui-*.png

# Visual/mobile audit output dirs (runtime artifacts of the sweep scripts, ~20MB).
# The SCRIPTS are source and are committed; their OUTPUT is not.
/audit-mobile-out/
/scripts/ui-screenshots/
/e2e/visual-shots/
/.playwright-mcp/

# local planning notes / runbook drafts (per-author)
docs/planning/*_NOTES.md

# Playwright (added 2026-07-19, skill v2 Phase 3b)
/playwright-report/
/blob-report/
/playwright/.cache/
/test-results/

# ZCode local session state (agent working files, not source)
/.zcode/

# Uploaded files from local test/e2e runs (runtime media artifacts, not source)
/public/uploads/

# local scratch golden-runner duplicate (use scripts/run-all-goldens.ts instead)
/_rungoldens.mjs

# The Playwright suite re-seeds (replaces) this on every run - it is a
# throwaway fixture, never the product data set. See e2e/helpers/data-dir.ts
.leadgen-data-e2e/

# Build output for the AUTH_MODE=production proof run (see docs/STAGE1-PRODUCTION-MODE-RUNBOOK.md).
# Same artefacts as /.next/, different directory so it cannot collide with a live dev server.
/.next-prod/

# mutation-sweep working dir (pristine snapshots + results); never committed
.mutation-sweep/

# golden test scratch (N-DATA-2): per-run throwaway data dirs, swept at suite start
.golden-scratch/
.env.e2e-branch
.env.e2e-pg

# Local measurement runs. The results worth keeping are copied into docs/measurements/.
.measure/
